# Google Cloud key with the Map Tiles API enabled
GOOGLE_MAPS_API_KEY=
# Lambda Cloud API key (cloud.lambda.ai -> API keys); used to find the GPU instance's IP
LAMBDA_API_KEY=
# Optional: instance name/id/IP if you have more than one running
LAMBDA_INSTANCE=
# Optional: override the inference endpoint (default http://127.0.0.1:18000/edit_b64 via SSH tunnel)
INFERENCE_URL=
# Deploy (scripts/deploy.py)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=isometric-mumbai-tiles
TILES_PUBLIC_BASE=https://tiles.isometricmumbai.com
PAGES_PROJECT=isometricmumbai
# Teacher model (pipeline/teacher.py); optional second key/org
OPENAI_API_KEY=
OPENAI_ORG_ID=
# GPU fleet (scripts/gpu_hunter.py)
LAMBDA_SSH_KEY_NAME=
TRAIN_HOST=ubuntu@
# Hugging Face (scripts/publish_hf.py)
HF_TOKEN=
HF_REPO=
